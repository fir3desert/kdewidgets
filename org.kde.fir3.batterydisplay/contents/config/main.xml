<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/2.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/2.0
                          http://www.kde.org/standards/kcfg/2.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <entry name="colorize" type="Bool">
            <default>true</default>
        </entry>
        <entry name="warningLevel" type="Int">
            <default>20</default>
        </entry>
        <entry name="criticalLevel" type="Int">
            <default>10</default>
        </entry>
        <entry name="chargingAnimation" type="Bool">
            <default>true</default>
        </entry>
        <entry name="animateWhenFull" type="Bool">
            <default>true</default>
        </entry>
        <entry name="previewAnimation" type="Bool">
            <default>false</default>
        </entry>
        <entry name="chargingAnimationStyle" type="String">
            <default>sweep</default>
        </entry>
    </group>
</kcfg>
